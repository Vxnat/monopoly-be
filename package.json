{
  "name": "monopoly-server",
  "version": "1.0.0",
  "description": "Colyseus Multiplayer Server for Monopoly 3D (Authoritative Game Server)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "colyseus": "^0.18.9",
    "@colyseus/schema": "^5.0.38",
    "@colyseus/ws-transport": "^0.18.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
